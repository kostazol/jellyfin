FROM node:24-alpine AS web

ARG JELLYFIN_VERSION=12.0-localized-alphabet
ENV JELLYFIN_VERSION=${JELLYFIN_VERSION}

RUN apk add --no-cache \
    autoconf \
    g++ \
    make \
    libpng-dev \
    gifsicle \
    alpine-sdk \
    automake \
    libtool \
    gcc \
    musl-dev \
    nasm \
    python3 \
    git

WORKDIR /src
COPY jellyfin-web .
RUN npm ci --no-audit --unsafe-perm \
 && npm run build:production \
 && mv dist /web

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS server

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
WORKDIR /src
COPY jellyfin-server .
RUN dotnet publish Jellyfin.Server \
    --runtime linux-x64 \
    --configuration Release \
    --output /server \
    --self-contained \
    -p:DebugSymbols=false \
    -p:DebugType=none

FROM jellyfin/jellyfin:12.0-rc5

USER root
RUN rm -rf /jellyfin/*
COPY --from=server /server /jellyfin
COPY --from=web /web /jellyfin/jellyfin-web
RUN chmod +x /jellyfin/jellyfin

LABEL org.opencontainers.image.source="https://github.com/kostazol/jellyfin"
LABEL org.opencontainers.image.description="Jellyfin 12 localized alphabet navigation test image"
LABEL org.opencontainers.image.revision.server="131759a99b42174b8caa1cab9ae2a4a858351cbf"
LABEL org.opencontainers.image.revision.web="22feeefa358364e1192ed6ac6b671f42b2680e6f"
